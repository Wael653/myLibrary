<% if (books.length > 0) { %>
    <div>Recently Added Books</div>
<% } else { %>
    <div>No books available</div>
<% } %>
<div>
<% books.forEach(book => { %>
    <a href="/books/<%= book.id %>">
        <img height="150" width="100" src="<%= book.coverImagePath %>">
    </a>
<% }); %>     
</div>  