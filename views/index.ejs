<% if (books.length > 0) { %>
    <h2 class="page-header">Recently Added Books</h2>
<% } else { %>
    <h2 class="page-header">No books available</h2>
<% } %>
<div>
<% books.forEach(book => { %>
    <a href="/books/<%= book.id %>">
        <img height="150" width="100" src="<%= book.coverImagePath %>">
    </a>
<% }); %>     
</div>  